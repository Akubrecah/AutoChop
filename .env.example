# ==============================================================================
# AutoChop AI Studio (v2) - Master Environment & API Key Configuration
# ==============================================================================
# Copy this file to .env and insert your API keys. Any provider left blank
# will seamlessly fall back to the built-in offline zero-key heuristic engine.
# ==============================================================================

# Primary AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ultra-Fast Cloud Providers
GROQ_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=

# OpenCode / Local AI / Custom OpenAI-Compatible Endpoints
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=llama3.3

# Runtime Performance Tunables
AUTOCHOP_MAX_UPLOAD_SIZE_MB=2048
AUTOCHOP_MAX_VIDEO_DURATION_SEC=3600.0
AUTOCHOP_SILENCE_THRESH_DB=-30.0
AUTOCHOP_MIN_SILENCE_SEC=0.5
AUTOCHOP_PADDING_SEC=0.15
AUTOCHOP_MIN_GAP_SEC=0.2
AUTOCHOP_MIN_SEGMENT_SEC=0.3
AUTOCHOP_MIN_CUE_DURATION=0.3
AUTOCHOP_MAX_RESOLUTION=1080p (Fast - Recommended)
AUTOCHOP_FFMPEG_PRESET=veryfast
AUTOCHOP_CRF=22
AUTOCHOP_WHISPER_MODEL=base
AUTOCHOP_COMPUTE_TYPE=int8
AUTOCHOP_LOG_LEVEL=INFO
